generator client {
 provider = "prisma-client"
 output = "../src/generated/prisma"
}
datasource db {
 provider = "postgresql"
}
model User {
 id String @id @default(cuid())
 email String @unique
 passwordHash String?
  sessions Session[]
  projects Project[]
 createdAt DateTime @default(now())
 updatedAt DateTime @updatedAt
}

model Project {
  id String @id @default(cuid())
  userId String
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  name String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  @@index([userId, createdAt])
}

model Session {
 tokenHash String @id
 userId String
 user User @relation(fields: [userId], references: [id], onDelete: Cascade)
 expiresAt DateTime
 createdAt DateTime @default(now())
 @@index([userId])
 @@index([expiresAt])
}

model AuthAttempt {
 key String @id
 count Int
 expiresAt DateTime
 @@index([expiresAt])
}
